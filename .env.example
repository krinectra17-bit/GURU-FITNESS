# Supabase Project Configuration
# Obtain from your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here

# Legacy / Alternative Anon Key alias (Supported)
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Meta WhatsApp Cloud API (Optional - for automated reminders)
VITE_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
VITE_WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
VITE_WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token_here

# Application Base URL
VITE_APP_URL=https://gurufitness.com
